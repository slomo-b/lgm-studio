{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LGM Studio",
  "version": "0.1.0",
  "identifier": "com.mo.lgmstudio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LGM Studio",
        "width": 1080,
        "height": 680,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Bild zu 3D-Asset",
    "longDescription": "Erzeugt aus einem Bild ein Gaussian-Splat, begrenzt es auf seine Silhouette und exportiert ein SimReady-USD."
  }
}
