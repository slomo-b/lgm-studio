{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LGM Studio",
  "version": "0.1.3",
  "identifier": "com.mo.lgmstudio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LGM Studio",
        "width": 1080,
        "height": 680,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../LGM/infer.py": "LGM/infer.py",
      "../LGM/mv_unet.py": "LGM/mv_unet.py",
      "../LGM/core": "LGM/core",
      "../LGM/mvdream": "LGM/mvdream",
      "../simready": "simready",
      "../tools/refine_splat.py": "tools/refine_splat.py",
      "../requirements-local.txt": "requirements-local.txt"
    },
    "shortDescription": "Bild zu 3D-Asset",
    "longDescription": "Erzeugt aus einem Bild ein Gaussian-Splat, begrenzt es auf seine Silhouette und exportiert ein SimReady-USD."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MjE2ODEzQUI0QkU3MTkKUldRWjUwdXJFMmdoZHQ4MlRabXBIMWxtM0FRQkRBeTJFejZVS1ZGUjFKbVo5cTZGa3BTb0FmNGMK",
      "endpoints": [
        "https://raw.githubusercontent.com/slomo-b/lgm-studio/main/latest.json"
      ]
    }
  }
}
